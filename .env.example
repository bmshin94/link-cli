# Enable the temporary local Privy-backed MPP implementation.
LINK_MPP_LOCAL_PRIVY=1

# Create these in the same Privy app. PRIVY_WALLET_ID is the server wallet ID,
# not its public Ethereum address.
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
PRIVY_WALLET_ID=your-privy-wallet-id

# Optional: use `link-cli auth login` instead for local interactive testing.
# LINK_ACCESS_TOKEN=your-link-access-token
